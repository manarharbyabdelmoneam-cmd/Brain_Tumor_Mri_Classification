# ============================================================
# .env.example
# مثال للمتغيرات البيئية - انسخ هذا الملف إلى .env وقم بتعديل القيم
# ============================================================

# ============================================================
# 1. إعدادات التطبيق العامة
# ============================================================

# اسم التطبيق
APP_NAME="🧠 NeuroScan AI"

# إصدار التطبيق
APP_VERSION="1.0.0"

# بيئة التشغيل (development, staging, production)
APP_ENVIRONMENT="development"

# وضع التصحيح (true/false)
APP_DEBUG=true

# ============================================================
# 2. مسارات النماذج والبيانات
# ============================================================

# مسار ملف النموذج الرئيسي
MODEL_PATH="models_saved/keras_model.h5"

# مسار أوزان النموذج
MODEL_WEIGHTS_PATH="models_saved/weights/mobilenetv2_weights.h5"

# مسار معلومات النموذج (metadata)
MODEL_METADATA_PATH="models_saved/metadata/model_config.json"

# مسار أسماء الفئات
CLASS_NAMES_PATH="models_saved/metadata/class_names.json"

# مسار بيانات التدريب
TRAIN_DATA_PATH="data/raw/Training"

# مسار بيانات الاختبار
TEST_DATA_PATH="data/raw/Testing"

# مسار مجلد المخرجات
OUTPUTS_PATH="outputs/"

# مسار مجلد التقارير
REPORTS_PATH="reports/"

# مسار مجلد السجلات
LOGS_PATH="logs/"

# ============================================================
# 3. إعدادات النموذج
# ============================================================

# حجم الصورة المدخلة (width,height)
INPUT_SIZE="224,224"

# عدد الفئات
NUM_CLASSES=4

# عدد القنوات اللونية
NUM_CHANNELS=3

# نسبة الـ Dropout
DROPOUT_RATE=0.3

# عدد الخلايا في الطبقة الكثيفة
DENSE_UNITS=128

# ============================================================
# 4. إعدادات التدريب
# ============================================================

# عدد الحلقات (Epochs)
TRAIN_EPOCHS=25

# حجم الدفعة (Batch Size)
TRAIN_BATCH_SIZE=32

# معدل التعلم (Learning Rate)
TRAIN_LEARNING_RATE=0.0001

# نسبة بيانات التحقق
TRAIN_VALIDATION_SPLIT=0.2

# عدد الحلقات قبل الإيقاف المبكر
EARLY_STOPPING_PATIENCE=5

# عدد الحلقات قبل تخفيض LR
REDUCE_LR_PATIENCE=3

# عامل تخفيض LR
REDUCE_LR_FACTOR=0.2

# تفعيل Data Augmentation (true/false)
USE_AUGMENTATION=true

# تفعيل Fine-tuning (true/false)
USE_FINE_TUNE=false

# عدد حلقات Fine-tuning
FINE_TUNE_EPOCHS=10

# معدل تعلم Fine-tuning
FINE_TUNE_LR=0.00001

# ============================================================
# 5. إعدادات التطبيق (Streamlit)
# ============================================================

# عنوان التطبيق
STREAMLIT_TITLE="🧠 Brain Tumor MRI Classifier"

# أيقونة التطبيق
STREAMLIT_FAVICON="🧠"

# وضع التطبيق (dark/light)
STREAMLIT_THEME="dark"

# منفذ التطبيق
STREAMLIT_PORT=8501

# الحد الأقصى لحجم الملف المرفوع (بالميجابايت)
MAX_UPLOAD_SIZE_MB=10

# الصيغ المسموحة للصور
ALLOWED_EXTENSIONS="jpg,jpeg,png"

# تفعيل Grad-CAM (true/false)
ENABLE_GRADCAM=true

# تفعيل سجل التنبؤات (true/false)
ENABLE_PREDICTION_LOG=true

# تفعيل حفظ الصور المرفوعة (true/false)
ENABLE_UPLOAD_SAVE=true

# ============================================================
# 6. إعدادات قاعدة البيانات (اختياري)
# ============================================================

# نوع قاعدة البيانات (sqlite, postgresql, mysql)
DB_TYPE="sqlite"

# مسار قاعدة البيانات (لـ SQLite)
DB_PATH="database/app.db"

# عنوان خادم قاعدة البيانات
DB_HOST="localhost"

# منفذ قاعدة البيانات
DB_PORT=5432

# اسم قاعدة البيانات
DB_NAME="brain_tumor_db"

# اسم المستخدم
DB_USER="admin"

# كلمة المرور
DB_PASSWORD="password"

# ============================================================
# 7. إعدادات السجلات (Logging)
# ============================================================

# مستوى التسجيل (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# مسار ملف السجل
LOG_FILE_PATH="logs/app.log"

# مسار ملف سجل التنبؤات
PREDICTION_LOG_PATH="logs/prediction_log.csv"

# الحد الأقصى لحجم ملف السجل (بالميجابايت)
LOG_MAX_SIZE_MB=10

# عدد النسخ الاحتياطية للسجلات
LOG_BACKUP_COUNT=5

# ============================================================
# 8. إعدادات البريد الإلكتروني (اختياري)
# ============================================================

# خادم SMTP
SMTP_HOST="smtp.gmail.com"

# منفذ SMTP
SMTP_PORT=587

# بريد المرسل
SMTP_USERNAME="support@braintumor.ai"

# كلمة مرور البريد
SMTP_PASSWORD="your_password"

# بريد الاستقبال
SMTP_RECIPIENT="admin@braintumor.ai"

# ============================================================
# 9. إعدادات API (اختياري)
# ============================================================

# مفتاح API (للخدمات الخارجية)
API_KEY="your_api_key"

# عنوان API
API_BASE_URL="https://api.braintumor.ai/v1"

# مهلة الاتصال (بالثواني)
API_TIMEOUT=30

# ============================================================
# 10. إعدادات الأمان
# ============================================================

# المفتاح السري للتطبيق
SECRET_KEY="your-secret-key-here-change-in-production"

# تفعيل CORS (true/false)
ENABLE_CORS=false

# تفعيل CSRF (true/false)
ENABLE_CSRF=true

# ============================================================
# 11. إعدادات الأداء
# ============================================================

# تفعيل التخزين المؤقت (true/false)
ENABLE_CACHE=true

# مدة التخزين المؤقت (بالثواني)
CACHE_TTL=3600

# تفعيل تحميل الصور بتأخير (Lazy Loading)
ENABLE_LAZY_LOADING=true

# ============================================================
# 12. إعدادات التقييم
# ============================================================

# تفعيل التقييم التلقائي (true/false)
AUTO_EVALUATE=true

# حفظ الرسوم البيانية (true/false)
SAVE_FIGURES=true

# حفظ التقارير (true/false)
SAVE_REPORTS=true
